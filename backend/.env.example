# Copy to backend/.env and fill in real values. backend/.env is gitignored
# and must never be committed.

# MongoDB connection string.
# Local dev:  mongodb://localhost:27017
# Production: an Atlas SRV string, e.g. mongodb+srv://user:pass@cluster.mongodb.net
MONGO_URL=

# Database name. Any string; Mongo creates it on first write.
DB_NAME=

# Comma-separated list of origins allowed to call this API (no spaces).
# Local dev:  http://localhost:3000
# Production: https://thebeat.randybongo.com
CORS_ORIGINS=

# Secret used to sign JWTs. The backend refuses to start without this.
# Generate one with: openssl rand -hex 32
# Rotating this invalidates every previously issued token (all users get
# logged out) - expected and fine, but worth knowing before you rotate one
# in production.
JWT_SECRET=
