# Copy to frontend/.env and fill in real values. frontend/.env is gitignored
# and must never be committed.

# Base URL of the backend API, no trailing slash and no /api suffix
# (the app appends /api itself).
# Local dev:  http://localhost:8001
# Production: your Render service URL, e.g. https://beat-goes-on-api.onrender.com
REACT_APP_BACKEND_URL=

# --- Dev-server only; not used in a production build (yarn build) ---

# Port the CRA dev server's hot-reload websocket connects to. Leave at 3000
# for local dev (matches `yarn start`'s default port).
WDS_SOCKET_PORT=3000

# Enables a custom webpack health-check plugin used in preview/dev
# environments. Leave false unless you know you need it.
ENABLE_HEALTH_CHECK=false
